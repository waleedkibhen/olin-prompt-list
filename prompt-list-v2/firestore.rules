rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Hardcoded superadmin email check
      return isAuthenticated() && request.auth.token.email == 'wisecrafts81@gmail.com';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- 1. Users Collection ---
    match /users/{userId} {
      // Anyone can read profiles
      allow read: if true;
      // Users can only create/update/delete their own profiles, admins can do anything
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // 1b. User Notifications Subcollection
    match /users/{userId}/notifications/{notificationId} {
      // Users can read/update/delete their own notifications
      allow read, update, delete: if isOwner(userId) || isAdmin();
      // Anyone authenticated can create a notification for someone else (e.g. liking a post)
      allow create: if isAuthenticated();
    }

    // --- 2. Posts Collection ---
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;
      
      // Creating a post: must be authenticated and the creatorId must match their UID
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      
      // Updating a post: 
      // Option A: The user is the creator (or admin)
      // Option B: The user is just liking/saving/viewing/copying (only updating metrics)
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) 
                    || isAdmin()
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'savesCount', 'viewsCount', 'copiesCount']));
      
      // Deleting a post: only the creator or admin
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
      
      // 2b. Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        // User must attach their own UID to the comment
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    // --- 3. Follows Collection ---
    match /follows/{followId} {
      allow read: if true;
      // User must attach their own UID as the follower
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
    }

    // --- 4. Support Tickets ---
    match /support_tickets/{ticketId} {
      // Anyone authenticated can submit a ticket
      allow create: if isAuthenticated();
      // Only admins can read, update, delete tickets
      allow read, update, delete: if isAdmin();
    }

    // --- 5. Reports ---
    match /reports/{reportId} {
      // Anyone authenticated can submit a report
      allow create: if isAuthenticated();
      // Only admins can read, update, delete reports
      allow read, update, delete: if isAdmin();
    }
  }
}
