rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Added email verification check to prevent spoofed unverified accounts
      return isAuthenticated() 
        && request.auth.token.email == 'wisecrafts81@gmail.com'
        && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- 1. Users Collection ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
      
      // 1b. User Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        
        // Prevent spoofing by enforcing that the sender ID matches the authenticated user
        allow create: if isAuthenticated() 
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // --- 2. Posts Collection ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      
      // Updating a post requires owner/admin status, OR restricts metric changes.
      // (Added check to prevent the creatorId from being changed during an update)
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == resource.data.creatorId) 
                    || isAdmin()
                    || (isAuthenticated() 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'savesCount', 'viewsCount', 'copiesCount'])
                    );
      
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
      
      // 2b. Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        
        // ALLOWING ANY AUTHENTICATED USER TO UPDATE LIKES & REPLIES
        allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'replyCount']))
                      || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
                      || isAdmin();
                      
        allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    // --- 3. Follows Collection ---
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
    }

    // --- 4. Support Tickets ---
    match /support_tickets/{ticketId} {
      // Enforce that the submitter is attaching their own ID to the ticket
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow users to read their own tickets to check status
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- 5. Reports ---
    match /reports/{reportId} {
      // Enforce that the submitter is attaching their own ID to the report
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
